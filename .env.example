# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API. These two are safe to expose in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web push public key (Phase 2). Generate a pair with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=
